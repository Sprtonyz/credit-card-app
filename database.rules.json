{
  "rules": {
    ".read": false,
    ".write": false,
    "appAccess": {
      ".read": false,
      ".write": false,
      "users": {
        "$uid": {
          ".read": "auth !== null && (auth.uid === $uid || root.child('appAccess/users').child(auth.uid).child('admin').val() === true)",
          ".write": "auth !== null && root.child('appAccess/users').child(auth.uid).child('admin').val() === true",
          "admin": {
            ".validate": "newData.isBoolean()"
          },
          "profiles": {
            "Tony": {
              ".validate": "newData.isBoolean()"
            },
            "Nugs": {
              ".validate": "newData.isBoolean()"
            },
            "$other": {
              ".validate": false
            }
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "transactions": {
      ".read": "auth !== null && root.child('appAccess/users').child(auth.uid).exists()",
      ".write": "auth !== null && root.child('appAccess/users').child(auth.uid).child('admin').val() === true",
      ".indexOn": ["date"]
    },
    "submissions": {
      ".read": "auth !== null && root.child('appAccess/users').child(auth.uid).exists()",
      ".write": "auth !== null && root.child('appAccess/users').child(auth.uid).child('admin').val() === true",
      "$txId": {
        "$user": {
          ".write": "($user === 'Tony' || $user === 'Nugs') && auth !== null && (root.child('appAccess/users').child(auth.uid).child('admin').val() === true || root.child('appAccess/users').child(auth.uid).child('profiles').child($user).val() === true)",
          ".validate": "newData.hasChildren(['value', 'ts'])",
          "value": {
            ".validate": "newData.isString() && (newData.val() === 'Unsure' || newData.val() === 'Macquarie' || newData.val() === 'Macqbill' || newData.val() === 'Tony' || newData.val() === 'Nugs' || newData.val() === 'Split')"
          },
          "ts": {
            ".validate": "newData.isNumber() && newData.val() > 0"
          },
          "day": {
            ".validate": "newData.isNumber()"
          },
          "dateKey": {
            ".validate": "newData.isString() && newData.val().matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/)"
          },
          "comment": {
            ".validate": "newData.isString() && newData.val().length <= 180"
          },
          "previousValue": {
            ".validate": "newData.isString() && (newData.val() === 'Unsure' || newData.val() === 'Macquarie' || newData.val() === 'Macqbill' || newData.val() === 'Tony' || newData.val() === 'Nugs' || newData.val() === 'Split')"
          },
          "previousDateKey": {
            ".validate": "newData.isString() && newData.val().matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/)"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "cc_v5_presence": {
      ".read": "auth !== null && root.child('appAccess/users').child(auth.uid).exists()",
      "$presenceId": {
        ".write": "auth !== null && root.child('appAccess/users').child(auth.uid).exists() && ((!newData.exists() && (!data.exists() || data.child('uid').val() === auth.uid)) || (newData.exists() && newData.child('uid').val() === auth.uid && (root.child('appAccess/users').child(auth.uid).child('admin').val() === true || root.child('appAccess/users').child(auth.uid).child('profiles').child(newData.child('user').val()).val() === true)))",
        ".validate": "newData.hasChildren(['user', 'uid', 'ts'])",
        "user": {
          ".validate": "newData.isString() && (newData.val() === 'Tony' || newData.val() === 'Nugs')"
        },
        "uid": {
          ".validate": "newData.isString() && newData.val() === auth.uid"
        },
        "ts": {
          ".validate": "newData.isNumber() && newData.val() > 0"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "cc_v5_app_state": {
      ".read": false,
      ".write": false,
      "simulatedDayOffset": {
        ".read": "auth !== null && root.child('appAccess/users').child(auth.uid).exists()",
        ".write": "auth !== null && root.child('appAccess/users').child(auth.uid).exists()",
        ".validate": "newData.isNumber()"
      },
      "petProfiles": {
        ".read": "auth !== null && root.child('appAccess/users').child(auth.uid).exists()",
        ".write": "auth !== null && root.child('appAccess/users').child(auth.uid).child('admin').val() === true",
        "$user": {
          ".write": "($user === 'Tony' || $user === 'Nugs') && auth !== null && (root.child('appAccess/users').child(auth.uid).child('admin').val() === true || root.child('appAccess/users').child(auth.uid).child('profiles').child($user).val() === true)",
          ".validate": "$user === 'Tony' || $user === 'Nugs'"
        }
      },
      "assignmentComments": {
        ".read": "auth !== null && root.child('appAccess/users').child(auth.uid).exists()",
        ".write": "auth !== null && root.child('appAccess/users').child(auth.uid).child('admin').val() === true",
        "$txId": {
          "$user": {
            ".write": "($user === 'Tony' || $user === 'Nugs') && auth !== null && (root.child('appAccess/users').child(auth.uid).child('admin').val() === true || root.child('appAccess/users').child(auth.uid).child('profiles').child($user).val() === true)",
            ".validate": "newData.hasChildren(['comment', 'ts'])",
            "comment": {
              ".validate": "newData.isString() && newData.val().length <= 180"
            },
            "value": {
              ".validate": "newData.isString() && (newData.val() === 'Unsure' || newData.val() === 'Macquarie' || newData.val() === 'Macqbill' || newData.val() === 'Tony' || newData.val() === 'Nugs' || newData.val() === 'Split')"
            },
            "ts": {
              ".validate": "newData.isNumber() && newData.val() > 0"
            },
            "dateKey": {
              ".validate": "newData.isString() && newData.val().matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/)"
            },
            "$other": {
              ".validate": false
            }
          }
        }
      },
      "userActivity": {
        ".read": "auth !== null && root.child('appAccess/users').child(auth.uid).child('admin').val() === true",
        ".write": "auth !== null && root.child('appAccess/users').child(auth.uid).child('admin').val() === true",
        "$user": {
          ".write": "($user === 'Tony' || $user === 'Nugs') && auth !== null && (root.child('appAccess/users').child(auth.uid).child('admin').val() === true || root.child('appAccess/users').child(auth.uid).child('profiles').child($user).val() === true)",
          ".validate": "newData.hasChildren(['user', 'lastSeen'])",
          "user": {
            ".validate": "newData.val() === $user"
          },
          "lastSeen": {
            ".validate": "newData.isNumber() && newData.val() > 0"
          },
          "uid": {
            ".validate": "newData.isString() && newData.val() === auth.uid"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "processedTransactions": {
      ".read": "auth !== null && root.child('appAccess/users').child(auth.uid).child('admin').val() === true",
      ".write": "auth !== null && root.child('appAccess/users').child(auth.uid).child('admin').val() === true"
    },
    "importAuditLog": {
      ".read": "auth !== null && root.child('appAccess/users').child(auth.uid).child('admin').val() === true",
      ".write": "auth !== null && root.child('appAccess/users').child(auth.uid).child('admin').val() === true"
    },
    "commonReoccurrences": {
      ".read": "auth !== null && root.child('appAccess/users').child(auth.uid).child('admin').val() === true",
      ".write": "auth !== null && root.child('appAccess/users').child(auth.uid).child('admin').val() === true"
    },
    "notificationAutomation": {
      ".read": "auth !== null && root.child('appAccess/users').child(auth.uid).child('admin').val() === true",
      ".write": "auth !== null && root.child('appAccess/users').child(auth.uid).child('admin').val() === true"
    },
    "pet": {
      ".read": "auth !== null && root.child('appAccess/users').child(auth.uid).exists()",
      ".write": "auth !== null && root.child('appAccess/users').child(auth.uid).child('admin').val() === true"
    },
    "food": {
      ".read": "auth !== null && root.child('appAccess/users').child(auth.uid).exists()",
      ".write": "auth !== null && root.child('appAccess/users').child(auth.uid).child('admin').val() === true"
    }
  }
}
