    "test:pet-profile-sync": "node ./scripts/verify-pet-profile-sync.mjs",
    "test:import-fingerprint": "node ./scripts/verify-import-fingerprint.mjs",
    "test:transaction-merger": "node ./scripts/verify-transaction-merger.mjs",
    "test:tally-cycle": "node ./scripts/verify-tally-cycle.mjs",
